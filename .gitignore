# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Tooling artifacts
.playwright-mcp/
.superpowers/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local AI agent instructions and state — kept out of this public repo.
# Anchored to the repository root on purpose: cortex/ and archive/ contain
# tracked AGENTS.md files, and an unanchored pattern would match those too.
/CLAUDE.md
/AGENTS.md
/.claude/

# wrangler local dev state
.wrangler/

# Local Pages Functions secrets (wrangler pages dev) — never commit
.dev.vars
.dev.vars.*
.wrangler/

# Client-facing deliverables (quotes, handoffs) — never commit to this public repo
/docs/deliverables/

# Agreement generator output and per-client Orders. An allowlist, not a
# blocklist: an Order holds a client's prices and this repo is public, so
# anything new in this folder must be ignored by default rather than only when
# its filename happens to match a pattern. Only the generator itself is tracked.
/docs/agreement/*
!/docs/agreement/generate_agreement.py
!/docs/agreement/requirements.txt
