/how-it-works/   /#how       301
/pricing         /#pricing   301
/pricing/        /#pricing   301
/portfolio       /#pf        301
/portfolio/      /#pf        301
/faq             /#faq       301
/faq/            /#faq       301
/contact         /#getquote  301
/contact/        /#getquote  301

# Retired redesign-preview path
/new/*           /           301
