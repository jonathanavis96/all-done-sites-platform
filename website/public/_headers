# Client quote pages are private links: never index them, and PDFs cannot carry
# a noindex meta tag, so the header is the only way to mark them.
/leroux/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Everything under /assets/ has a content hash in its filename, so a changed file
# gets a new URL and these can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
